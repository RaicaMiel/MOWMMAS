# MOWMMAS Admin backend settings, read by src/config.js.
# Copy this file to .env in this folder (User/Admin/Backend/.env) and put the real values there.
# .env is private and never committed; this example holds no real values.
# Lines starting with # are ignored: a setting left commented out uses the default shown.

# ── Firebase (required by the server and by npm run facilities): fill in all four ──
# Web API key of the Firebase project (Firebase console > Project settings > General > Web API key)
FIREBASE_API_KEY=
# Firebase project ID (Project settings > General > Project ID)
FIREBASE_PROJECT_ID=
# Email of the admin account the backend signs in as (Authentication > Users; it needs a record in admins/<uid>)
FIREBASE_ADMIN_EMAIL=
# That admin account's password
FIREBASE_ADMIN_PASSWORD=

# ── Firestore collections ──
# Collection with the mothers' donations, requests and inquiries
# FIRESTORE_SUBMISSIONS_COLLECTION=submissions
# Collection with the health facilities (the admin's Facilities page)
# FIRESTORE_FACILITIES_COLLECTION=facilities

# ── The admin API ──
# Port of the admin API
# ADMIN_PORT=4000
# Address the admin API listens on (127.0.0.1: only this computer)
# ADMIN_HOST=127.0.0.1
# Pages allowed to call the admin API from a browser, comma-separated
# ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5500,http://localhost:5500,http://localhost:4000,http://127.0.0.1:4000
# Folder for the admin backend's own state (default: User/Admin/Backend/data)
# ADMIN_DATA_DIR=/path/to/User/Admin/Backend/data
# Folder with the mother backend's data (default: User/Mother/Backend/data)
# MOWMMA_DB_DIR=/path/to/User/Mother/Backend/data

# ── Sync with Firestore ──
# How often waiting submissions are sent again, in milliseconds
# FIRESTORE_SYNC_INTERVAL_MS=60000
# How often the full facility list is copied again, in milliseconds (6 hours)
# FIRESTORE_FACILITY_REFRESH_MS=21600000

# ── SMS through PhilSMS (https://dashboard.philsms.com/developers) ──
# PhilSMS API address
# PHILSMS_API_URL=https://dashboard.philsms.com/api/v3
# PhilSMS API token (blank or missing: no SMS is sent)
# PHILSMS_API_TOKEN=your-philsms-api-token
# An approved Sender ID (blank: the account's default)
# PHILSMS_SENDER_ID=your-sender-id
# "Form received" texts a day in all (0 turns them off)
# SMS_AUTO_DAILY_LIMIT=100
# "Form received" texts a day to one number
# SMS_RECEIVED_PER_NUMBER_DAILY=3
# Automatic texts an hour to one number
# SMS_AUTO_PER_NUMBER_HOURLY=5
